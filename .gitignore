# ---- Dependencies ----
node_modules/

# ---- Build outputs (regenerated from source) ----
dist/
out/
build/
*.tsbuildinfo

# ---- Per-package build dirs (explicit, in case the wildcards above change) ----
packages/schema/dist/
packages/cli/dist/
packages/app/out/
packages/app/dist-electron/

# ---- WalkingCode runtime (per-user: pid locks, app.log) ----
# Both a repo-local one and the home-dir one (defensive).
.walkingcode/
**/.walkingcode/runtime/

# ---- Comments sidecars (user-generated; not part of the project) ----
# These are written next to arch files at runtime by the GUI/CLI.
*.comments.json

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- Agent / tooling internal state ----
.zcode/
